{
  "name": "claudinho",
  "productName": "Claudinho",
  "desktopName": "claudinho.desktop",
  "version": "1.0.3",
  "private": true,
  "description": "Claudinho: o seu Claude Code, agora com mais vida",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:deb": "electron-builder --linux deb"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "ascii-magic-art": "^1.1.0",
    "electron-updater": "^6.8.11",
    "marked": "^18.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "author": {
    "name": "Luis Roberto",
    "url": "https://luisrobertoportifolio.com"
  },
  "homepage": "https://meuclaudinho.com.br",
  "build": {
    "appId": "com.claudinho.app",
    "productName": "Claudinho",
    "copyright": "Luis Roberto",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icone.ico"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icone-512.png",
      "category": "Development",
      "synopsis": "O seu Claude Code, agora com mais vida",
      "desktop": {
        "entry": {
          "StartupWMClass": "claudinho"
        }
      },
      "maintainer": "Luis Roberto <Lu1sR0@users.noreply.github.com>",
      "artifactName": "Claudinho-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claudinho",
      "artifactName": "Claudinho-Setup.exe",
      "installerIcon": "src/icone.ico",
      "uninstallerIcon": "src/icone.ico",
      "uninstallDisplayName": "Claudinho"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lu1sR0",
        "repo": "claudinho",
        "releaseType": "release"
      }
    ]
  }
}
